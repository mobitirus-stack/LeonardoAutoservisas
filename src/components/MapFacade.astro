---
import { site } from '../config/site';
---
<div class="map" id="map" data-src={site.MAP_EMBED_URL} data-title={`Leonardo autoservisas žemėlapyje – ${site.address.street}, ${site.address.city}`}>
  <div class="map-facade">
    <svg class="map-pin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5a8 8 0 0 0-8 8c0 6 8 13 8 13s8-7 8-13a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
    <p>{site.address.full}</p>
    <button class="btn btn-primary" type="button" id="map-btn">Rodyti žemėlapį</button>
  </div>
</div>
<p class="note">Žemėlapis įkeliamas iš „Google“ tik paspaudus mygtuką. <a href={site.mapsUrl} rel="noopener" target="_blank">Atidaryti „Google Maps“</a></p>
<script is:inline src="/js/map.js" defer></script>
